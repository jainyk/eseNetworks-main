#!/bin/sh
set -eu

# Rancher Desktop Windows provisioning hook. It runs as root in the Rancher
# WSL distro before Rancher's containerd service starts.
VERSION="0.18.2"
ARCHIVE="stargz-snapshotter-v${VERSION}-linux-amd64.tar.gz"
URL="https://github.com/containerd/stargz-snapshotter/releases/download/v${VERSION}/${ARCHIVE}"
SHA256="515a3c3af0012f192ace31fb79e910597977c77227e976680aeaaef6e9ae50a9"
CONTAINERD_CONFIG="/etc/containerd/config.toml"
BACKUP="/etc/containerd/config.toml.poc-stargz-backup"
SOCKET="/run/containerd-stargz-grpc/containerd-stargz-grpc.sock"

if [ ! -x /usr/local/bin/containerd-stargz-grpc ]; then
    tmp="/tmp/${ARCHIVE}"
    staged=""
    for candidate in /mnt/c/Users/*/AppData/Local/rancher-desktop/provisioning/${ARCHIVE}; do
        if [ -f "$candidate" ]; then
            staged="$candidate"
            break
        fi
    done
    if [ -n "$staged" ]; then
        cp "$staged" "$tmp"
    else
        curl --fail --location --silent --show-error "$URL" --output "$tmp"
    fi
    printf '%s  %s\n' "$SHA256" "$tmp" | sha256sum -c
    tar -xzf "$tmp" -C /usr/local/bin containerd-stargz-grpc ctr-remote
    rm -f "$tmp"
    chmod 0755 /usr/local/bin/containerd-stargz-grpc /usr/local/bin/ctr-remote
fi

mkdir -p /etc/containerd-stargz-grpc /var/lib/containerd-stargz-grpc /run/containerd-stargz-grpc
if [ ! -f /etc/containerd-stargz-grpc/config.toml ]; then
    printf '# Stargz Snapshotter default configuration for the PoC.\n' \
        > /etc/containerd-stargz-grpc/config.toml
fi

if [ ! -f "$BACKUP" ]; then
    cp -p "$CONTAINERD_CONFIG" "$BACKUP"
fi

if ! grep -Fq '[proxy_plugins.stargz]' "$CONTAINERD_CONFIG"; then
    cat >> "$CONTAINERD_CONFIG" <<'EOF'

# Registered by the container cold-start PoC.
[proxy_plugins.stargz]
  type = "snapshot"
  address = "/run/containerd-stargz-grpc/containerd-stargz-grpc.sock"

[proxy_plugins.stargz.exports]
  root = "/var/lib/containerd-stargz-grpc/"
EOF
fi

cat > /etc/init.d/containerd-stargz-grpc <<'EOF'
#!/sbin/openrc-run
supervisor=supervise-daemon
name="Stargz Snapshotter"
description="Lazy-pull snapshotter for containerd"
command="/usr/local/bin/containerd-stargz-grpc"
command_args="--log-level=info --config=/etc/containerd-stargz-grpc/config.toml"
pidfile="/run/containerd-stargz-grpc.pid"
output_log="/var/log/containerd-stargz-grpc.log"
error_log="/var/log/containerd-stargz-grpc.log"
supervise_daemon_args="--respawn-delay 1 --respawn-max 5 --respawn-period 60"

depend() {
    need localmount
    before containerd
}
EOF
chmod 0755 /etc/init.d/containerd-stargz-grpc

if ! containerd config dump >/dev/null; then
    echo "Rancher containerd config validation failed; restore $BACKUP before restarting containerd." >&2
    exit 1
fi

rc-service containerd-stargz-grpc start
attempt=0
until [ -S "$SOCKET" ]; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 50 ]; then
        echo "Stargz Snapshotter did not create $SOCKET; see /var/log/containerd-stargz-grpc.log" >&2
        exit 1
    fi
    sleep 0.2
done

echo "Stargz Snapshotter ${VERSION} is ready at ${SOCKET}."
